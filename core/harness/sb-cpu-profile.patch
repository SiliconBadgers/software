diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 8bb0ff7..5a5cf43 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -477,6 +477,19 @@ typedef pthread_mutex_t    ggml_mutex_t;
 
 #endif
 
+// SiliconBadgers opt-in CPU operation trace. Allocation and JSON serialization
+// are outside graph execution; thread 0 only records timestamps and node indices.
+struct sb_cpu_trace_record {
+    int node_index;
+    int n_fused;
+    int64_t elapsed_us;
+};
+
+struct sb_cpu_trace {
+    struct sb_cpu_trace_record * records;
+    int count;
+};
+
 // Threadpool def
 struct ggml_threadpool {
     ggml_mutex_t mutex;       // mutex for cond.var
@@ -484,6 +497,7 @@ struct ggml_threadpool {
 
     struct ggml_cgraph * cgraph;
     struct ggml_cplan  * cplan;
+    struct sb_cpu_trace * sb_trace;
 
     // synchronization primitives
     atomic_int n_graph;       // updated when there is work to be done (i.e each graph) holds graph and active thread counts.
@@ -3106,6 +3120,71 @@ static int ggml_cpu_try_fuse_ops(
     return 0;
 }
 
+// The metadata is inspected only after all workers have completed the graph.
+static void sb_cpu_json_string(FILE * file, const char * text) {
+    fputc('"', file);
+    for (const unsigned char * p = (const unsigned char *) text; *p; ++p) {
+        if (*p == '"' || *p == '\\') {
+            fputc('\\', file);
+            fputc(*p, file);
+        } else if (*p < 0x20) {
+            fprintf(file, "\\u%04x", (unsigned) *p);
+        } else {
+            fputc(*p, file);
+        }
+    }
+    fputc('"', file);
+}
+
+static void sb_cpu_json_tensor(FILE * file, const struct ggml_tensor * tensor) {
+    fputs("{\"name\":", file);
+    sb_cpu_json_string(file, tensor->name);
+    fputs(",\"op\":", file);
+    sb_cpu_json_string(file, ggml_op_name(tensor->op));
+    fprintf(file, ",\"nbytes\":%zu,\"is_view\":%s", ggml_nbytes(tensor), tensor->view_src ? "true" : "false");
+    fputs(",\"dtype\":", file);
+    sb_cpu_json_string(file, ggml_type_name(tensor->type));
+    fprintf(file, ",\"ne\":[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "]}",
+            tensor->ne[0], tensor->ne[1], tensor->ne[2], tensor->ne[3]);
+}
+
+static void sb_cpu_trace_flush(const char * path, const char * phase,
+                              const struct ggml_cgraph * cgraph,
+                              const struct sb_cpu_trace * trace,
+                              int n_threads, enum ggml_status status) {
+    static atomic_int graph_sequence = 0;
+    const int graph_id = atomic_fetch_add_explicit(&graph_sequence, 1, memory_order_relaxed);
+    FILE * file = fopen(path, "a");
+    if (!file) {
+        GGML_LOG_WARN("SB_CPU_TRACE: cannot append to %s: %s\n", path, strerror(errno));
+        return;
+    }
+    for (int i = 0; i < trace->count; ++i) {
+        const struct sb_cpu_trace_record * record = &trace->records[i];
+        const struct ggml_tensor * node = cgraph->nodes[record->node_index];
+        fprintf(file, "{\"graph_id\":%d,\"phase\":", graph_id);
+        sb_cpu_json_string(file, phase);
+        fprintf(file, ",\"node_index\":%d,\"n_threads\":%d,\"graph_status\":%d,\"elapsed_us\":%" PRId64 ",\"tensor\":",
+                record->node_index, n_threads, (int) status, record->elapsed_us);
+        sb_cpu_json_tensor(file, node);
+        fputs(",\"src\":[", file);
+        for (int src = 0; src < GGML_MAX_SRC; ++src) {
+            if (src) fputc(',', file);
+            if (node->src[src]) sb_cpu_json_tensor(file, node->src[src]);
+            else fputs("null", file);
+        }
+        fputs("],\"fused_successors\":[", file);
+        for (int fused = 1; fused <= record->n_fused; ++fused) {
+            if (fused > 1) fputc(',', file);
+            sb_cpu_json_tensor(file, cgraph->nodes[record->node_index + fused]);
+        }
+        fputs("]}\n", file);
+    }
+    if (fclose(file) != 0) {
+        GGML_LOG_WARN("SB_CPU_TRACE: cannot finish writing %s: %s\n", path, strerror(errno));
+    }
+}
+
 static thread_ret_t ggml_graph_compute_thread(void * data) {
     struct ggml_compute_state * state = (struct ggml_compute_state *) data;
     struct ggml_threadpool    * tp    = state->threadpool;
@@ -3134,6 +3213,10 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
     GGML_PRINT_DEBUG("thread #%d compute-start cplan %p last-graph %d\n", state->ith, (const void *)cplan, state->last_graph);
 #endif
 
+    struct sb_cpu_trace * trace = state->ith == 0 ? tp->sb_trace : NULL;
+    int pending_record = -1;
+    int64_t pending_start_us = 0;
+
     for (int node_n = 0; node_n < cgraph->n_nodes && atomic_load_explicit(&tp->abort, memory_order_relaxed) != node_n; node_n++) {
         struct ggml_tensor * node = cgraph->nodes[node_n];
 
@@ -3146,6 +3229,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
             continue;
         }
 
+        const int original_node_n = node_n;
+        const int64_t trace_start_us = trace ? ggml_time_us() : 0;
+
         // TODO: move fused-op detection into ggml_graph_plan so fusion decisions are made once at planning time
         // Try fused ops, fall back to normal compute
         const int n_fused = ggml_cpu_try_fuse_ops(cgraph, node_n, &params, cplan);
@@ -3164,6 +3250,19 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
         if (node_n + 1 < cgraph->n_nodes) {
             ggml_barrier(state->threadpool);
         }
+        if (trace) {
+            struct sb_cpu_trace_record * record = &trace->records[trace->count++];
+            record->node_index = original_node_n;
+            record->n_fused = n_fused;
+            if (node_n + 1 < cgraph->n_nodes) {
+                record->elapsed_us = ggml_time_us() - trace_start_us;
+            } else {
+                // The last node has no per-node barrier. Its completion must
+                // be measured after the existing final graph barrier below.
+                pending_record = trace->count - 1;
+                pending_start_us = trace_start_us;
+            }
+        }
     }
 
 #ifdef GGML_USE_OPENMP
@@ -3173,6 +3272,9 @@ static thread_ret_t ggml_graph_compute_thread(void * data) {
 #endif
 
     ggml_barrier(state->threadpool);
+    if (pending_record >= 0) {
+        trace->records[pending_record].elapsed_us = ggml_time_us() - pending_start_us;
+    }
 
 #ifdef GGML_USE_CPU_RISCV64_SPACEMIT
     ggml_backend_cpu_riscv64_spacemit_clear_numa_thread_affinity_threaded(state->ith);
@@ -3329,6 +3431,7 @@ static struct ggml_threadpool * ggml_threadpool_new_impl(
     {
         threadpool->cgraph           = cgraph;
         threadpool->cplan            = cplan;
+        threadpool->sb_trace         = NULL;
         threadpool->n_graph          = 0;
         threadpool->n_barrier        = 0;
         threadpool->n_barrier_passed = 0;
@@ -3424,6 +3527,23 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
         threadpool->ec               = GGML_STATUS_SUCCESS;
     }
 
+    // getenv/allocation happen before workers are released. The harness must
+    // only change these environment variables between synchronized decode calls.
+    const char * trace_path = getenv("SB_CPU_TRACE");
+    const char * trace_phase = getenv("SB_CPU_PHASE");
+    if (!trace_phase) trace_phase = "unspecified";
+    struct sb_cpu_trace trace = { NULL, 0 };
+    threadpool->sb_trace = NULL;
+    if (trace_path && *trace_path && cgraph->n_nodes > 0 &&
+            strncmp(trace_phase, "warmup", 6) != 0 && strcmp(trace_phase, "idle") != 0) {
+        trace.records = calloc((size_t) cgraph->n_nodes, sizeof(*trace.records));
+        if (trace.records) {
+            threadpool->sb_trace = &trace;
+        } else {
+            GGML_LOG_WARN("SB_CPU_TRACE: record allocation failed\n");
+        }
+    }
+
 #ifdef GGML_USE_OPENMP
     if (n_threads > 1) {
         #pragma omp parallel num_threads(n_threads)
@@ -3466,6 +3586,12 @@ enum ggml_status ggml_graph_compute(struct ggml_cgraph * cgraph, struct ggml_cpl
 
     enum ggml_status ret = threadpool->ec;
 
+    if (trace.records) {
+        sb_cpu_trace_flush(trace_path, trace_phase, cgraph, &trace, n_threads, ret);
+        free(trace.records);
+        threadpool->sb_trace = NULL;
+    }
+
     if (disposable_threadpool) {
         ggml_threadpool_free(threadpool);
     }
